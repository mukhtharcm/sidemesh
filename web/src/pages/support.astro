---
import Base from '../layouts/Base.astro';
import { links } from '../site.ts';
---
<Base
  title="Support — Sidemesh"
  description="Get help with Sidemesh. Common issues, setup guidance, and how to reach us."
  path="/support"
>
  <div class="page">
    <div class="container">
      <header class="page__header">
        <p class="kicker"><span class="node" aria-hidden="true"></span>Sidemesh · Help</p>
        <h1>Support</h1>
        <p>Quick answers to common questions and how to get in touch if you need more help.</p>
      </header>

      <div class="help-list">
        <section class="help-item" aria-labelledby="help-start">
          <h2 id="help-start">Getting started</h2>
          <p>
            Install the host on a trusted machine with <code>npm install -g sidemesh @openai/codex</code>,
            then run <code>sidemesh up</code>. Open the app and scan the pairing QR code, or add the
            host manually. The app will connect directly to your host over your private network.
            The <a href={links.readme}>setup guide on GitHub</a> covers other agents and options.
          </p>
        </section>

        <section class="help-item" aria-labelledby="help-reach">
          <h2 id="help-reach">The app cannot reach my host</h2>
          <p>
            Make sure your device and host are on the same network or connected through Tailscale.
            Verify the daemon is running with <code>sidemesh status</code>,
            and run <code>sidemesh doctor</code> to check the host and its agents. Check that the host
            address and token in the app match what the daemon printed during setup.
          </p>
        </section>

        <section class="help-item" aria-labelledby="help-notifications">
          <h2 id="help-notifications">Notifications are not arriving</h2>
          <p>
            Enable notifications for Sidemesh in iOS Settings → Notifications. Background sync
            also requires Background App Refresh to be enabled. The app checks for updates
            periodically when in the background.
          </p>
        </section>

        <section class="help-item" aria-labelledby="help-live-activities">
          <h2 id="help-live-activities">Live Activities are not showing</h2>
          <p>
            Live Activities require iOS 16.1 or later. Make sure they are enabled in
            Settings → Sidemesh → Live Activities. They appear when an agent session is active.
          </p>
        </section>

        <section class="help-item" aria-labelledby="help-contact">
          <h2 id="help-contact">Contact us</h2>
          <p>
            For bugs and feature requests, open an issue on <a href={links.issues}>GitHub</a>.
            Report security vulnerabilities privately through <a href={links.securityAdvisory}>GitHub Security Advisories</a>;
            never put tokens, hostnames, logs, or private paths in a public issue.
          </p>
          <p>For setup questions, you can also ask in the Sidemesh Discord.</p>
          <div class="actions">
            <a class="button button--primary" href={links.issues}>Open a GitHub issue</a>
            <a class="button button--secondary" href={links.discord}>Join the Discord</a>
          </div>
        </section>
      </div>
    </div>
  </div>
</Base>
