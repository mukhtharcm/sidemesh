---
import Base from '../layouts/Base.astro';
import { links } from '../site.ts';
---
<Base
  title="Sidemesh Discord"
  description="Join the Sidemesh Discord. Use the short link to open the community invite."
  path="/discord"
  ogTitle="Join the Sidemesh Discord"
  ogDescription="Open the Sidemesh community invite from a short sidemesh.com link."
  ogImageAlt="Sidemesh community invite."
  redirectTo={links.discordInvite}
>
  <div class="page">
    <div class="container notice">
      <img class="notice__icon" src="/favicon.svg" alt="" width="64" height="64" />
      <h1>Redirecting to Discord.</h1>
      <p>If nothing opens, use the button below.</p>
      <div class="actions">
        <a class="button button--primary" href={links.discordInvite}>Open Discord</a>
        <a class="button button--secondary" href="/">Back to sidemesh.com</a>
      </div>
      <div class="notice__meta">
        <p>Short link: <code>sidemesh.com/discord</code></p>
      </div>
    </div>
  </div>
</Base>
