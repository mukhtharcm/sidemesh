---
// The landing page: a day away from your desk, told in colour fields with a
// phone that follows the story.
import Base from '../layouts/Base.astro';
import AwayScreen from '../components/AwayScreen.astro';
import { links } from '../site.ts';

type ScreenKind = 'live' | 'approve' | 'review' | 'question' | 'quiet';

const moments: {
  id: string;
  time: string;
  band: string;
  kind: ScreenKind;
  where: string;
  title: string;
  text: string;
}[] = [
  {
    id: 't-1012',
    time: '10:12',
    band: 'day',
    kind: 'approve',
    where: 'In the coffee line',
    title: 'It asks. You decide.',
    text: 'Codex wants to run a command. The request reaches your phone with the command and the folder in plain sight. Approve or decline, and the work carries on at your laptop.',
  },
  {
    id: 't-1305',
    time: '13:05',
    band: 'noon',
    kind: 'review',
    where: 'At lunch',
    title: 'Check the work.',
    text: 'Pi finished on the workstation. Read its reply, look through the changed files and the diff, and send a follow-up if it missed something.',
  },
  {
    id: 't-1748',
    time: '17:48',
    band: 'dusk',
    kind: 'question',
    where: 'On the train home',
    title: 'Answer in a tap.',
    text: 'Copilot CLI on your cloud server has a question. Pick an answer and it carries on. Every machine you pair shows up in the same app.',
  },
  {
    id: 't-2310',
    time: '23:10',
    band: 'night',
    kind: 'quiet',
    where: 'Before bed',
    title: 'Nothing waiting.',
    text: 'Every session from every machine, in one list you can search later. Tonight there is nothing left to decide.',
  },
];

const day = [{ id: 't-0840', time: '08:40', kind: 'live' as ScreenKind }, ...moments];

const agents = [
  { name: 'Codex', note: 'The default setup' },
  { name: 'Pi', note: 'Supported' },
  { name: 'GitHub Copilot CLI', note: 'Supported' },
  { name: 'ACP agents', note: 'Agents that speak the Agent Client Protocol' },
  { name: 'OpenCode', note: 'In development' },
];

const safeguards = [
  {
    title: 'Private network only',
    text: 'Connect over Tailscale, a VPN or your own network. The host is not meant for the public internet.',
  },
  {
    title: 'A token on every request',
    text: 'Pairing gives the app an access token. Requests without it are refused.',
  },
  {
    title: 'Powerful tools start off',
    text: 'The host terminal and browser tabs stay disabled until you turn them on.',
  },
  {
    title: 'No account, no analytics',
    text: 'The app has no Sidemesh account, ads or third-party analytics.',
  },
];

const steps = [
  { command: 'npm install -g sidemesh @openai/codex', text: 'Install the host and Codex. Needs Node.js 22.19 or newer.' },
  { command: 'sidemesh up', text: 'Start the host and show the pairing QR code. Scan it in the app.' },
  { command: 'sidemesh service install', text: 'Keep the host running after a restart.' },
];

const digits = (time: string) => time.split('');
---
<Base
  title="Sidemesh — Leave your desk. Not your agents."
  description="Sidemesh keeps the coding agents on your own machines within reach of your phone and desktop. Follow the work, approve what needs approving, answer what needs answering."
  path="/"
  landing
>
  <div class="day" data-day>
    <section class="band band--morning band--hero" id="t-0840" data-scene="live" data-time="08:40">
      <span class="sun sun--morning" aria-hidden="true"></span>
      <header class="top">
        <a class="brand" href="/" aria-label="Sidemesh home">
          <svg viewBox="0 0 48 48" width="34" height="34" aria-hidden="true">
            <path d="M15 13 37 24 15 35" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" />
            <circle cx="15" cy="13" r="4.6" fill="currentColor" />
            <circle cx="15" cy="35" r="4.6" fill="currentColor" />
            <circle cx="37" cy="24" r="6" fill="currentColor" />
          </svg>
          <span>Sidemesh</span>
        </a>
        <nav class="top__nav" aria-label="Main">
          <a href="#agents">Agents</a>
          <a href="#network">Security</a>
          <a href="#install">Install</a>
          <a href={links.github}>GitHub</a>
        </nav>
      </header>

      <div class="wrap hero">
        <div class="col">
          <p class="kicker"><span class="kicker__time">08:40</span> You start a task and head out</p>
          <h1 class="hero__title">
            <span class="line"><span>Leave your desk.</span></span>
            <span class="line"><span>Not your agents.</span></span>
          </h1>
          <p class="hero__lede">
            Sidemesh keeps the coding agents on your own machines within reach of your phone and desktop. Follow
            the work, approve what needs approving, answer what needs answering.
          </p>
          <div class="actions">
            <a class="cta" href="#install">Get started</a>
            <a class="cta cta--ghost" href={links.testflight}>Join the iPhone beta</a>
          </div>
          <p class="hero__fine">
            Open source. No account. No cloud workspace. <a href={links.github}>See the code on GitHub</a>.
          </p>
          <div class="moment__card" aria-label="Illustration of the Lock Screen at 08:40">
            <AwayScreen kind="live" />
          </div>
          <p class="scroll-cue" aria-hidden="true">Scroll through a day <span>↓</span></p>
        </div>
      </div>
    </section>

    {moments.map((moment) => (
      <section
        class={`band band--${moment.band} moment`}
        id={moment.id}
        data-scene={moment.kind}
        data-time={moment.time}
        aria-labelledby={`${moment.id}-title`}
      >
        <span class={`sun sun--${moment.band}`} aria-hidden="true"></span>
        <div class="wrap">
          <div class="col">
            <p class="moment__time" aria-hidden="true" data-clock>
              {digits(moment.time).map((digit, index) => (
                <span style={`--d:${index}`}>{digit}</span>
              ))}
            </p>
            <p class="kicker">
              <span class="sr-only">{moment.time}, </span>{moment.where}
            </p>
            <h2 id={`${moment.id}-title`} class="moment__title">{moment.title}</h2>
            <p class="moment__text">{moment.text}</p>
            <div class="moment__card" aria-label={`Illustration of the phone at ${moment.time}`}>
              <AwayScreen kind={moment.kind} />
            </div>
          </div>
        </div>
      </section>
    ))}

    <div class="rail">
      <div class="rail__inner">
        <div class="rail__stack">
          <div class="phone" data-phone data-scene="live" aria-label="Illustration of the Sidemesh app through the day">
            <span class="phone__island" aria-hidden="true"></span>
            <div class="phone__status" aria-hidden="true">
              <span data-phone-clock>08:40</span>
              <span class="phone__signal"><i></i><i></i><i></i><i></i></span>
            </div>
            <div class="phone__screens">
              {day.map((item) => (
                <div class="phone__screen" data-for={item.kind}>
                  <AwayScreen kind={item.kind} />
                </div>
              ))}
            </div>
          </div>
          <nav class="strip" aria-label="Times of the day">
            {day.map((item) => (
              <a href={`#${item.id}`} data-strip={item.kind}>{item.time}</a>
            ))}
          </nav>
          <p class="rail__note">Illustration, not a screenshot</p>
        </div>
      </div>
    </div>
  </div>

  <section class="band band--night plain" id="agents" aria-labelledby="agents-title">
    <div class="wrap">
      <h2 id="agents-title" class="plain__title">Works with the agents you already run.</h2>
      <ul class="agents">
        {agents.map((agent) => (
          <li>
            <span class="agents__name">{agent.name}</span>
            <span class="agents__note">{agent.note}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band band--moon plain" id="network" aria-labelledby="network-title">
    <div class="wrap split">
      <div>
        <h2 id="network-title" class="plain__title">Your machines.<br />Your network.</h2>
        <p class="plain__lede">
          Sidemesh is a small host on each machine and an app that talks to it directly. Nothing sits in between.
        </p>
        <p class="plain__fine"><a href="/privacy">Read the privacy policy</a></p>
      </div>
      <ol class="guards">
        {safeguards.map((item, index) => (
          <li>
            <span class="guards__n" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="band band--go plain" id="install" aria-labelledby="install-title">
    <div class="wrap">
      <h2 id="install-title" class="plain__title plain__title--huge">Three commands.</h2>
      <ol class="steps">
        {steps.map((step, index) => (
          <li>
            <span class="steps__n" aria-hidden="true">{index + 1}</span>
            <code>{step.command}</code>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
      <p class="plain__fine">
        Using Pi, Copilot CLI or an ACP agent? Run <code>sidemesh setup</code> to choose.
        <a href={links.readme}>Full setup guide on GitHub</a>
      </p>
    </div>
  </section>

  <section class="band band--moon plain" id="apps" aria-labelledby="apps-title">
    <div class="wrap">
      <h2 id="apps-title" class="plain__title">Then pick it up anywhere.</h2>
      <ul class="apps">
        <li>
          <h3>iPhone</h3>
          <p>The beta is open on TestFlight, with notifications and Live Activities.</p>
          <a class="cta" href={links.testflight}>Join the beta</a>
        </li>
        <li>
          <h3>Mac</h3>
          <p>Download the latest macOS build from the project's GitHub releases.</p>
          <a class="cta cta--ghost" href={links.releases}>Open GitHub releases</a>
        </li>
        <li>
          <h3>Web</h3>
          <p>Use Sidemesh in a browser. Hosts on other machines need an HTTPS address.</p>
          <a class="cta cta--ghost" href={links.webApp}>Open app.sidemesh.com</a>
        </li>
      </ul>
    </div>
  </section>
  <script>
    import '../scripts/away.ts';
  </script>
</Base>
