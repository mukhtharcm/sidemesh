---
import Base from '../layouts/Base.astro';
import { links } from '../site.ts';
---
<Base
  title="Sidemesh TestFlight"
  description="Join the Sidemesh iOS beta on TestFlight. Install the host daemon first, then open the app from a short shareable URL."
  path="/testflight"
  ogTitle="Join Sidemesh on TestFlight"
  ogDescription="Short link for the Sidemesh iOS beta. Install the host daemon first, then open the app in TestFlight."
  ogImage="/assets/testflight-og.png"
  ogImageAlt="Sidemesh TestFlight invite card."
  redirectTo={links.testflightJoin}
>
  <div class="page">
    <div class="container notice">
      <img class="notice__icon" src="/favicon.svg" alt="" width="64" height="64" />
      <h1>Redirecting to TestFlight.</h1>
      <p>If nothing opens, use the button below.</p>
      <div class="actions">
        <a class="button button--primary" href={links.testflightJoin}>Open TestFlight</a>
        <a class="button button--secondary" href="/">Back to sidemesh.com</a>
      </div>
      <div class="notice__meta">
        <p>Short link: <code>sidemesh.com/testflight</code></p>
        <p>
          Install the host daemon first so the app is useful once it opens.{' '}
          <a href="/#install">How to install the host</a>.
        </p>
      </div>
    </div>
  </div>
</Base>
